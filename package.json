{
  "name": "fadblock",
  "version": "1.0.49",
  "description": "FAdblock — Chrome ve Firefox ucun ad blocker extension",
  "private": true,
  "scripts": {
    "prepare": "cp scripts/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit",
    "generate:rules": "node scripts/generate-rules.js",
    "generate:icons": "node scripts/generate-icons.js",
    "generate": "npm run generate:rules && npm run generate:icons",
    "pack:chrome": "node scripts/build-chrome.js",
    "pack:firefox": "node scripts/build-firefox.js",
    "install:local": "bash scripts/install.sh"
  },
  "devDependencies": {
    "canvas": "^3.2.3",
    "playwright": "^1.60.0",
    "web-ext": "^10.3.0"
  }
}
